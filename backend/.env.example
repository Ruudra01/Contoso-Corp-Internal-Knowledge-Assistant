# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
#
# Leave the two API keys BLANK to authenticate with Managed Identity
# (DefaultAzureCredential), which is how the deployed Container Apps job runs.
# Set them only for local development against a real service.

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
# Required. The service URL, no trailing slash and no index path.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net

# Required to create or write the index. Blank => DefaultAzureCredential, which
# needs the "Search Index Data Contributor" and "Search Service Contributor"
# roles for the identity.
AZURE_SEARCH_API_KEY=

# The index to read and write. Bump this to stand up a new index rather than
# migrating an existing one — a change in embedding width REQUIRES a new index.
AZURE_SEARCH_INDEX_NAME=contoso-policies-v1

# Documents per indexing request. Azure caps a batch at 1000 documents / 16 MB.
AZURE_SEARCH_UPLOAD_BATCH_SIZE=100

# Candidate pool per query before reranking (solution design 4.2 uses 30).
AZURE_SEARCH_DEFAULT_TOP=30

# Semantic (cross-encoder) reranking on hybrid and keyword queries. Requires a
# Basic tier or above; set false on the Free tier or the query is rejected.
AZURE_SEARCH_USE_SEMANTIC_RANKER=true

# ---------------------------------------------------------------------------
# Azure OpenAI — embeddings
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com

# Blank => DefaultAzureCredential, which needs the "Cognitive Services OpenAI
# User" role for the identity.
AZURE_OPENAI_API_KEY=

AZURE_OPENAI_API_VERSION=2024-10-21

# The *deployment* name in your Azure OpenAI resource, not the model name —
# they are often but not always the same.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# MUST match the index's vector width. text-embedding-3-large is 3072,
# text-embedding-3-small is 1536. Changing this requires a new index.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

AZURE_OPENAI_EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Corpus
# ---------------------------------------------------------------------------
CORPUS_ROOT=../data

# Base URL citations resolve against. Empty falls back to a local file:// URI.
SOURCE_URI_BASE=https://<storage-account>.blob.core.windows.net/corpus/raw

# ---------------------------------------------------------------------------
# Chunking (solution design 4.1)
# ---------------------------------------------------------------------------
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
CHUNK_MAX_TOKENS=1200

LOG_LEVEL=INFO
