# Copy to backend/.env and fill in. Never commit the filled-in file.
# Leave the API keys blank to authenticate with Managed Identity
# (DefaultAzureCredential), which is how the deployed job runs.

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=contoso-policies-v1
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_UPLOAD_BATCH_SIZE=100

# --- Azure OpenAI (embeddings) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
AZURE_OPENAI_EMBEDDING_BATCH_SIZE=16

# --- Corpus ---
CORPUS_ROOT=../data
SOURCE_URI_BASE=https://<account>.blob.core.windows.net/corpus/raw

# --- Chunking (solution design 4.1) ---
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
CHUNK_MAX_TOKENS=1200

LOG_LEVEL=INFO
